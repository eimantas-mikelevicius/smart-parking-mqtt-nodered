{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "uniwa/iot/ice26390276/parking/state.schema.json",
  "title": "Parking spot occupancy (state) message",
  "type": "object",
  "required": ["device_id", "zone", "type", "value", "unit", "ts", "seq"],
  "additionalProperties": true,
  "properties": {
    "device_id": { "type": "string", "pattern": "^[A-Z]-[0-9]{2}$" },
    "zone":      { "type": "string", "pattern": "^[A-Z]$" },
    "type":      { "type": "string", "enum": ["occupancy"] },
    "value":     { "type": "integer", "enum": [0, 1] },
    "unit":      { "type": "string", "enum": ["bool"] },
    "ts":        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "seq":       { "type": "integer", "minimum": 0 }
  }
}
